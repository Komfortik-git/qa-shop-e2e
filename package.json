{
  "name": "qa-shop",
  "version": "1.0.0",
  "description": "Учебный интернет-магазин «Лавка»",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "test:bugs": "playwright test --grep BUG-",
    "test:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=mobile-chromium --project=mobile-webkit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
